{
  "name": "chzzk-bot-platform",
  "version": "1.0.0",
  "private": true,
  "description": "치지직 챗봇 SaaS 플랫폼 — 사용자 · 관리자 · 내부관리자 · Core 봇 런타임",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:api": "pnpm --filter @chzzk-bot/api dev",
    "dev:core": "pnpm --filter @chzzk-bot/core dev",
    "dev:web": "pnpm --filter @chzzk-bot/web dev",
    "dev:backoffice": "pnpm --filter @chzzk-bot/backoffice dev",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run test",
    "test:coverage": "vitest run --coverage",
    "bench": "turbo run bench",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test",
    "db:generate": "pnpm --filter @chzzk-bot/database db:generate",
    "db:migrate": "pnpm --filter @chzzk-bot/database db:migrate",
    "db:deploy": "pnpm --filter @chzzk-bot/database db:deploy",
    "db:studio": "pnpm --filter @chzzk-bot/database db:studio",
    "db:seed": "pnpm --filter @chzzk-bot/database db:seed",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "audit": "pnpm audit --audit-level high"
  },
  "devDependencies": {
    "@chzzk-bot/eslint-config": "workspace:*",
    "@chzzk-bot/prettier-config": "workspace:*",
    "@chzzk-bot/tsconfig": "workspace:*",
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  },
  "prettier": "@chzzk-bot/prettier-config",
  "license": "MIT"
}
