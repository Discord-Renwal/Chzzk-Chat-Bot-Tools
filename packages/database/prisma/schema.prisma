// 치지직 챗봇 플랫폼 데이터 모델
//
// 테넌시 규칙 — 예외 없이 지킵니다.
//   1. 사용자가 만든 모든 데이터에는 `tenantId` 가 있습니다.
//   2. 조회는 언제나 tenantId 로 좁힙니다. 리포지토리 계층이 이를 강제합니다.
//   3. 테넌트를 지우면 딸린 데이터도 함께 지워집니다(onDelete: Cascade).
//
// 봇 설정은 두 갈래로 나눠 담습니다. 개수가 늘어나고 내부 관리자가 집계해야 하는
// 것(명령어·자동응답·금칙어·주기메시지)은 테이블로, 채널당 하나뿐인 설정 묶음은
// Json 컬럼으로 둡니다. 후자를 정규화하면 컬럼 60개짜리 테이블이 되고 설정 항목
// 하나 추가할 때마다 마이그레이션이 필요해집니다.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── 계정 ──────────────────────────────────────────────────────────────────────

enum PlatformRole {
  MEMBER
  SUPPORT
  OPERATOR
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

model User {
  id              String       @id @default(cuid())
  /// 치지직 채널 ID. 로그인 식별자이자 채팅에서 사람을 알아보는 열쇠입니다.
  chzzkChannelId  String       @unique
  channelName     String
  profileImageUrl String?
  email           String?
  platformRole    PlatformRole @default(MEMBER)
  status          UserStatus   @default(ACTIVE)

  suspendedReason String?
  suspendedUntil  DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?
  deletedAt   DateTime?

  oauthAccount OAuthAccount?
  sessions     Session[]
  memberships  Membership[]
  ownedTenants Tenant[]       @relation("TenantOwner")
  billingCards BillingCard[]
  auditLogs    AuditLog[]     @relation("AuditActor")

  @@index([status, createdAt])
  @@index([channelName])
  @@map("users")
}

/// 치지직 OAuth 토큰.
///
/// 봇이 남의 채널에서 채팅을 읽고 쓰려면 그 채널 주인의 토큰이 필요합니다.
/// 그래서 **리프레시 토큰까지** 보관해야 하고, 반드시 암호화해 넣습니다
/// (`packages/auth` 의 encryptSecret). 컬럼 이름에 Enc 를 붙여 평문을 넣는
/// 실수를 코드 리뷰에서 바로 잡을 수 있게 했습니다.
model OAuthAccount {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider           String   @default("chzzk")
  accessTokenEnc     String
  refreshTokenEnc    String
  accessTokenExpires DateTime
  scope              String
  updatedAt          DateTime @updatedAt

  @@map("oauth_accounts")
}

/// 로그인 세션. 토큰 원문이 아니라 해시만 저장합니다 — DB 가 새도 세션을 훔칠 수 없게.
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  userAgent String?
  ip        String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
  @@map("sessions")
}

// ─── 테넌트(채널 워크스페이스) ─────────────────────────────────────────────────

enum TenantStatus {
  ACTIVE
  PAUSED
  SUSPENDED
}

enum TenantRole {
  OWNER
  MANAGER
  VIEWER
}

model Tenant {
  id             String       @id @default(cuid())
  /// URL 에 쓰는 사람이 읽을 수 있는 식별자
  slug           String       @unique
  chzzkChannelId String       @unique
  channelName    String
  status         TenantStatus @default(ACTIVE)

  ownerId String
  owner   User   @relation("TenantOwner", fields: [ownerId], references: [id])

  suspendedReason String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  members       Membership[]
  settings      BotSettings?
  commands      Command[]
  autoResponses AutoResponse[]
  bannedWords   BannedWord[]
  timers        TimerMessage[]
  viewers       Viewer[]
  songRequests  SongRequest[]
  events        BotEvent[]
  instance      BotInstance?
  subscription  Subscription?
  payments      Payment[]
  apiKeys       ApiKey[]

  @@index([status])
  @@index([ownerId])
  @@map("tenants")
}

model Membership {
  id       String     @id @default(cuid())
  tenantId String
  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId   String
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     TenantRole @default(MANAGER)

  createdAt DateTime @default(now())

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("memberships")
}

// ─── 봇 설정 ───────────────────────────────────────────────────────────────────

/// 채널당 하나뿐인 설정 묶음.
///
/// 각 컬럼은 `@chzzk-bot/contracts` 의 zod 스키마 한 조각과 1:1 로 대응합니다.
/// 읽을 때 반드시 그 스키마로 파싱하므로, 손으로 고친 Json 이 깨져 있어도
/// 봇이 이상하게 동작하는 대신 그 자리에서 드러납니다.
model BotSettings {
  id       String @id @default(cuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  general       Json
  permissions   Json
  /// 금칙어 목록(words)은 빼고 저장합니다 — 그쪽은 BannedWord 테이블입니다.
  moderation    Json
  points        Json
  songs         Json
  games         Json
  notifications Json

  updatedAt   DateTime @updatedAt
  updatedById String?

  @@map("bot_settings")
}

enum CommandKind {
  text
  list
  counter
}

enum MatchMode {
  contains
  equals
  startsWith
  regex
}

enum ModerationAction {
  blind
  blindAndWarn
  blindAndTempBan
}

model Command {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name           String
  aliases        String[]    @default([])
  kind           CommandKind @default(text)
  response       String      @default("")
  items          String[]    @default([])
  count          Int         @default(0)
  useRoles       String[]
  editRoles      String[]
  subscriberOnly Boolean     @default(false)
  cooldownSec    Int         @default(3)
  enabled        Boolean     @default(true)
  usedCount      Int         @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// 한 채널 안에서 이름이 겹치면 뒤엣것이 영영 실행되지 않습니다. DB 가 막습니다.
  @@unique([tenantId, name])
  @@index([tenantId, enabled])
  @@map("commands")
}

model AutoResponse {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  label         String    @default("")
  pattern       String
  mode          MatchMode @default(contains)
  caseSensitive Boolean   @default(false)
  response      String
  cooldownSec   Int       @default(10)
  chancePercent Int       @default(100)
  enabled       Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, enabled])
  @@map("auto_responses")
}

model BannedWord {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  pattern       String
  mode          MatchMode        @default(contains)
  caseSensitive Boolean          @default(false)
  action        ModerationAction @default(blindAndWarn)
  warnMessage   String           @default("")
  enabled       Boolean          @default(true)
  hitCount      Int              @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, enabled])
  @@map("banned_words")
}

model TimerMessage {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  label            String  @default("")
  message          String
  intervalMinutes  Int     @default(15)
  minChatsSinceLast Int    @default(10)
  enabled          Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, enabled])
  @@map("timer_messages")
}

// ─── 시청자 데이터 ─────────────────────────────────────────────────────────────

/// 채널별 시청자 누적 데이터.
///
/// 채팅 1건마다 갱신되므로 가장 뜨거운 테이블입니다. Core 는 메모리에서 다루고
/// 주기적으로 한꺼번에 내려씁니다 — 채팅마다 UPDATE 를 날리면 DB 가 먼저 죽습니다.
model Viewer {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  chzzkChannelId String
  nickname       String @default("")

  points             Int      @default(0)
  chatCount          Int      @default(0)
  firstSeenAt        DateTime @default(now())
  lastSeenAt         DateTime @default(now())
  attendanceStreak   Int      @default(0)
  lastAttendanceDate String   @default("")

  @@unique([tenantId, chzzkChannelId])
  @@index([tenantId, points(sort: Desc)])
  @@map("viewers")
}

enum SongStatus {
  queued
  playing
  done
  skipped
}

model SongRequest {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  title              String
  requesterChannelId String
  requesterNickname  String
  status             SongStatus @default(queued)
  pointsSpent        Int        @default(0)

  requestedAt DateTime  @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?

  @@index([tenantId, status, requestedAt])
  @@map("song_requests")
}

enum BotEventKind {
  chat
  command
  auto
  moderation
  donation
  subscription
  song
  system
  error
}

/// 채널별 활동 로그. 플랜에 따라 보관 기간이 다르고 배치가 오래된 것을 지웁니다.
model BotEvent {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  kind    BotEventKind
  message String
  actor   String?
  detail  String?

  createdAt DateTime @default(now())

  @@index([tenantId, createdAt(sort: Desc)])
  @@map("bot_events")
}

// ─── 봇 런타임 ─────────────────────────────────────────────────────────────────

enum BotStatus {
  STOPPED
  STARTING
  IDLE
  JOINED
  ERROR
}

/// 지금 이 채널의 봇이 어떤 상태인지.
///
/// Core 워커가 쓰고 API 가 읽습니다. 두 프로세스가 공유하는 유일한 런타임 상태라
/// 하트비트를 함께 둡니다 — 워커가 죽으면 lastHeartbeatAt 이 멈추고, API 는
/// 그것만 보고 "응답 없음" 을 판정할 수 있습니다.
model BotInstance {
  id       String @id @default(cuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  status   BotStatus @default(STOPPED)
  workerId String?

  /// `!입장` 을 친 사람
  joinedBy      String?
  joinedAt      DateTime?
  chatChannelId String?
  sessionKey    String?

  startedAt       DateTime?
  lastHeartbeatAt DateTime?
  lastError       String?

  /// 재시작해도 이어지도록 통계 스냅샷을 함께 둡니다.
  statsSnapshot Json?

  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([workerId])
  @@map("bot_instances")
}

/// 외부에서 명령 실행 API 를 부를 때 쓰는 키. 해시만 저장합니다.
model ApiKey {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name       String
  keyHash    String    @unique
  /// 화면에 보여줄 앞 8자리. 어느 키인지 알아보게만 합니다.
  keyPrefix  String
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([tenantId])
  @@map("api_keys")
}

// ─── 결제 ──────────────────────────────────────────────────────────────────────

model Plan {
  id           String  @id @default(cuid())
  code         String  @unique
  name         String
  description  String  @default("")
  priceMonthly Int
  currency     String  @default("KRW")
  features     Json
  limits       Json
  isPublic     Boolean @default(true)
  sortOrder    Int     @default(0)
  active       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]

  @@map("plans")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

model Subscription {
  id       String @id @default(cuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId   String
  plan     Plan   @relation(fields: [planId], references: [id])

  status SubscriptionStatus @default(TRIALING)

  currentPeriodStart DateTime  @default(now())
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean   @default(false)
  canceledAt         DateTime?
  cancelReason       String?
  trialEndsAt        DateTime?

  /// 자동 결제에 쓸 카드
  billingCardId String?
  billingCard   BillingCard? @relation(fields: [billingCardId], references: [id])

  /// 결제 실패 재시도 횟수. 성공하면 0으로 되돌립니다.
  failedAttempts Int       @default(0)
  nextBillingAt  DateTime?

  /// 내부 관리자가 결제 없이 열어준 건이면 그 사유
  overrideReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[]

  @@index([status, currentPeriodEnd])
  @@index([nextBillingAt])
  @@map("subscriptions")
}

/// PortOne 빌링키. 원문은 암호화해 넣고, 화면에는 마스킹된 카드번호만 보여줍니다.
model BillingCard {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  pgProvider    String @default("portone")
  billingKeyEnc String
  issuer        String
  maskedNumber  String

  isDefault Boolean   @default(false)
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  subscriptions Subscription[]

  @@index([userId])
  @@map("billing_cards")
}

enum PaymentStatus {
  READY
  PAID
  FAILED
  CANCELLED
  PARTIAL_REFUNDED
  REFUNDED
}

model Payment {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])

  /// PG 사가 부여한 식별자. 같은 결제를 두 번 기록하지 않도록 유니크로 둡니다.
  paymentId      String        @unique
  orderName      String
  amount         Int
  refundedAmount Int           @default(0)
  currency       String        @default("KRW")
  status         PaymentStatus @default(READY)
  method         String?
  paidAt         DateTime?
  failureReason  String?
  receiptUrl     String?

  /// PG 원본 응답. 대사(reconciliation)와 분쟁 대응에 필요합니다.
  raw Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@map("payments")
}

/// 받은 웹훅 원본.
///
/// eventId 를 유니크로 두어 같은 알림이 두 번 와도 두 번 처리되지 않게 합니다.
/// PG 웹훅은 재전송이 정상 동작이라 멱등성은 선택이 아닙니다.
model WebhookEvent {
  id       String @id @default(cuid())
  provider String @default("portone")
  eventId  String
  type     String
  payload  Json

  status      String    @default("RECEIVED")
  error       String?
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@unique([provider, eventId])
  @@index([status, receivedAt])
  @@map("webhook_events")
}

// ─── 내부 관리 ─────────────────────────────────────────────────────────────────

enum AuditActorType {
  USER
  STAFF
  SYSTEM
  WEBHOOK
}

/// 누가 · 무엇을 · 왜 했는지.
///
/// 남의 데이터를 건드리는 모든 관리 동작이 여기 남습니다. 지울 수 없어야 하므로
/// 어떤 리포지토리도 delete 를 제공하지 않습니다.
model AuditLog {
  id        String         @id @default(cuid())
  actorType AuditActorType
  actorId   String?
  actor     User?          @relation("AuditActor", fields: [actorId], references: [id])
  actorName String?

  action     String
  targetType String?
  targetId   String?
  tenantId   String?
  reason     String?
  metadata   Json?

  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([actorId, createdAt])
  @@index([tenantId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

enum AnnouncementLevel {
  INFO
  WARNING
  CRITICAL
}

model Announcement {
  id    String            @id @default(cuid())
  title String
  body  String
  level AnnouncementLevel @default(INFO)

  publishedAt DateTime?
  expiresAt   DateTime?
  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([publishedAt])
  @@map("announcements")
}

model FeatureFlag {
  id             String   @id @default(cuid())
  key            String   @unique
  description    String   @default("")
  enabled        Boolean  @default(false)
  rolloutPercent Int      @default(0)
  allowTenantIds String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("feature_flags")
}
