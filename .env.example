# ─────────────────────────────────────────────────────────────────────────────
# 공통
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=development
# silent | error | warn | info | debug
LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────────────────────
# 치지직 애플리케이션
# https://developers.chzzk.naver.com/application 에서 발급받습니다.
# ─────────────────────────────────────────────────────────────────────────────
CHZZK_CLIENT_ID=
CHZZK_CLIENT_SECRET=
# 개발자센터의 "로그인 리디렉션 URL" 과 문자 단위로 정확히 일치해야 합니다.
CHZZK_REDIRECT_URI=http://localhost:4000/api/auth/callback

# ─────────────────────────────────────────────────────────────────────────────
# 데이터베이스
# `pnpm infra:up` 으로 띄운 Postgres 의 기본값입니다.
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://chzzkbot:chzzkbot@localhost:5432/chzzkbot?schema=public

# ─────────────────────────────────────────────────────────────────────────────
# 암호화 · 세션
#
# TOKEN_ENCRYPTION_KEY 는 고객의 치지직 리프레시 토큰을 암호화합니다. 이 값을
# 잃어버리면 저장된 토큰을 아무도 복호화할 수 없어 모든 사용자가 재로그인해야
# 하고, 반대로 이 값이 새면 남의 방송 계정을 조작할 수 있습니다.
#
#   openssl rand -base64 32   → TOKEN_ENCRYPTION_KEY
#   openssl rand -hex 32      → SESSION_SECRET / INTERNAL_API_TOKEN
# ─────────────────────────────────────────────────────────────────────────────
TOKEN_ENCRYPTION_KEY=
SESSION_SECRET=
# API 서버와 Core 워커 사이의 공유 비밀. 없으면 누구나 남의 봇을 조작할 수 있습니다.
INTERNAL_API_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# API 서버 (apps/api)
# ─────────────────────────────────────────────────────────────────────────────
API_PORT=4000
API_HOST=0.0.0.0
WEB_ORIGIN=http://localhost:5173
BACKOFFICE_ORIGIN=http://localhost:5174
CORE_INTERNAL_URL=http://127.0.0.1:4100

# ─────────────────────────────────────────────────────────────────────────────
# Core 워커 (apps/core)
# 제어 API 는 내부망 전용입니다. 루프백 밖으로 열지 마세요.
# ─────────────────────────────────────────────────────────────────────────────
CORE_PORT=4100
CORE_HOST=127.0.0.1
CORE_WORKER_ID=core-1
# 이 워커가 맡을 최대 채널 수
CORE_MAX_TENANTS=200
# 설정을 DB 에서 다시 읽는 주기(ms)
CORE_CONFIG_REFRESH_MS=30000

# ─────────────────────────────────────────────────────────────────────────────
# 결제 (PortOne V2)
# https://admin.portone.io 에서 발급받습니다.
#
# PORTONE_MOCK=true 로 두면 실제 결제 없이 구독 흐름을 전부 눌러 볼 수 있습니다.
# 프로덕션에서는 켜지지 않도록 부팅 시점에 막혀 있습니다.
# ─────────────────────────────────────────────────────────────────────────────
PORTONE_MOCK=true
PORTONE_STORE_ID=store-00000000-0000-0000-0000-000000000000
PORTONE_API_SECRET=
PORTONE_CHANNEL_KEY=channel-key-00000000-0000-0000-0000-000000000000
PORTONE_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# 최초 관리자 (선택)
#
# `pnpm db:seed` 실행 시 최고 관리자가 한 명도 없으면 이 채널 ID 를 최고
# 관리자로 지정합니다. 첫 배포에서 아무도 관리자 콘솔에 못 들어가는 상황을 막습니다.
# ─────────────────────────────────────────────────────────────────────────────
BOOTSTRAP_SUPER_ADMIN_CHANNEL_ID=

# ─────────────────────────────────────────────────────────────────────────────
# 개발자 도구 (pnpm --filter @chzzk-bot/core login / doctor)
# 단일 계정으로 치지직 API 를 확인할 때만 씁니다. 서비스 코드는 쓰지 않습니다.
# ─────────────────────────────────────────────────────────────────────────────
CHZZK_LOGIN_PORT=3000
CHZZK_TOKEN_FILE=.tokens/chzzk.json
